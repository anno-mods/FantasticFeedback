<UserControl x:Class="FeedbackEditor.Views.Nodes.WalkRandomNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FeedbackEditor.Views.Nodes"
             xmlns:views="clr-namespace:NodeNetwork.Views;assembly=NodeNetwork"
             xmlns:controls="clr-namespace:Stopbyte.Controls"
             mc:Ignorable="d" 
             x:Name="WalkRandomView"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <views:NodeView x:Name="NodeView"
                        BorderBrush="{StaticResource WalkRandomActionAccentColorBrush}"
                        CornerRadius="15">
            <views:NodeView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource WalkRandomActionColor}" />
                    <GradientStop Color="{StaticResource NodeBackground}" Offset="0.4"/>
                </LinearGradientBrush>
            </views:NodeView.Background>
            <views:NodeView.TrailingControlPresenterStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical"
                                            Margin="10">
                                    <Label Content="Walk Sequence"
                                           Margin="5"
                                           Style="{StaticResource MaterialDesignLabel}"
                                           VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding Source={StaticResource SequenceIdValues}}"
                                              SelectedItem="{Binding DataContext.ViewModel.Action.WalkSequence, UpdateSourceTrigger=PropertyChanged, ElementName=WalkRandomView}"
                                              Height="30"
                                              Margin="5"
                                              VerticalContentAlignment="Center"></ComboBox>
                                    <Grid Cursor="">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Label Content="Random Radius"
                                               Margin="5"
                                               ToolTip="The radius around the Target Dummy in which a random target position is chosen"
                                               Style="{StaticResource MaterialDesignLabel}"
                                               VerticalAlignment="Center"/>
                                        <controls:NumericSpinner Value="{Binding DataContext.ViewModel.Action.RandomRadius, UpdateSourceTrigger=PropertyChanged, ElementName=WalkRandomView}"
                                                                 Grid.Column="1"
                                                                 Decimals="2"
                                                                 Step="0.01"
                                                                 Grid.ColumnSpan="2"
                                                                 MinValue="0"
                                                                 MaxValue="10"
                                                                 Height="32"
                                                                 Margin="3"
                                                                 ValueChanged="NumericSpinner_ValueChanged">
                                        </controls:NumericSpinner>
                                        
                                        <Label Content="Target Dummy"
                                               Grid.Row="3"
                                               ToolTip="Dummy that defines the center of the Target Area. Drag and Drop a Dummy from the Right Side into the box to set this Dummy"
                                               Margin="5"
                                               Style="{StaticResource MaterialDesignLabel}"
                                               VerticalAlignment="Center" />
                                        <TextBox Grid.Row="3"
                                                 Grid.Column="1"
                                                 Text="{Binding DataContext.ViewModel.CenterDummy.Name, UpdateSourceTrigger=PropertyChanged, ElementName=WalkRandomView}"
                                                 AllowDrop="True"
                                                 Background="Transparent"
                                                 IsReadOnly="True"
                                                 MinWidth="130"
                                                 Drop="OnCenterDummyDropped"
                                                 PreviewDragOver="OnPreviewDropAcceptOnlyDummies"
                                                 BorderThickness="1"
                                                 Margin="3"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}">
                                        </TextBox>


                                        <Label Content="Target Direction"
                                               Grid.Row="4"
                                               ToolTip="Dummy that defines the center of the Target Area. Drag and Drop a Dummy from the Right Side into the box to set this Dummy"
                                               Margin="5"
                                               Style="{StaticResource MaterialDesignLabel}" />
                                        <controls:NumericSpinner Value="{Binding DataContext.ViewModel.Action.TargetDirection, UpdateSourceTrigger=PropertyChanged, ElementName=WalkRandomView}"
                                                                 Grid.Column="1"
                                                                 Grid.Row="4"
                                                                 Decimals="2"
                                                                 Step="0.01"
                                                                 Grid.ColumnSpan="2"
                                                                 MinValue="0"
                                                                 MaxValue="10"
                                                                 Height="32"
                                                                 Margin="3"
                                                                 ValueChanged="NumericSpinner_ValueChanged">
                                        </controls:NumericSpinner>
                                    </Grid>
                                    <CheckBox Content="Use Target Direction"
                                              Margin="5"
                                              HorizontalAlignment="Left"
                                              Background="{StaticResource PlayActionAccentColorBrush}"
                                              IsChecked="{Binding DataContext.ViewModel.Action.UseTargetDirection, ElementName=WalkRandomView}"
                                              Style="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}" />
                                    <CheckBox Content="Walk from current Position"
                                              Margin="5"
                                              HorizontalAlignment="Left"
                                              Background="{StaticResource PlayActionAccentColorBrush}"
                                              IsChecked="{Binding DataContext.ViewModel.Action.WalkFromCurrentPosition, ElementName=WalkRandomView}"
                                              Style="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </views:NodeView.TrailingControlPresenterStyle>
        </views:NodeView>
    </Grid>
</UserControl>
