<Window x:Class="FeedbackEditor.Views.CreateWalksequencePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FeedbackEditor.Views"
        xmlns:controls="clr-namespace:Stopbyte.Controls"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="CreateWalksequencePopup" Height="500" Width="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="0,1">
                <GradientStop Color="{StaticResource WalkActionColor}" />
                <GradientStop Color="{StaticResource NodeBackground}"
                              Offset="0.2" />
            </LinearGradientBrush>
        </Grid.Background>
        <TextBlock Text="Set Default Values for all Nodes here" Style="{DynamicResource MaterialDesignLabelLargeTextBlock}"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextColorBrush}"/>
        <StackPanel Orientation="Vertical"
                    Margin="10"
                    Grid.Row="1">
            <Label Content="Template Walk Sequence"
                   ToolTip="All Nodes will get this Sequence as Walk Sequence"
                   HorizontalAlignment="Center"
                   Margin="5"
                   FontSize="14"
                   Style="{StaticResource MaterialDesignLabel}"
                   VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Source={StaticResource SequenceIdValues}}"
                      SelectedItem="{Binding ViewModel.Action.WalkSequence, UpdateSourceTrigger=PropertyChanged}"
                      Height="30"
                      Foreground="{DynamicResource TextColorBrush}"
                      Margin="5"
                      VerticalContentAlignment="Center"></ComboBox>

            <Label Content="Generate from Group"
                   Margin="3"
                   HorizontalAlignment="Center"
                   FontSize="14"
                   ToolTip="The Walk Sequence will visit all Dummies in this Group in order of their suffix. Dummies without Suffix will be generated at the start, however: don't expect that to work."
                   Style="{StaticResource MaterialDesignLabel}"
                   VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding DummyGroups.ReadonlyGroups, UpdateSourceTrigger=PropertyChanged}"
                      SelectedItem="{Binding SelectedGroup, UpdateSourceTrigger=PropertyChanged}"
                      Height="30"
                      Margin="5"
                      Grid.ColumnSpan="2"
                      VerticalContentAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource TextColorBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Grid Cursor="">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Label Content="Speed Factor"
                       Margin="5"
                       ToolTip="Sets the Speed Factor for all Nodes"
                       Style="{StaticResource MaterialDesignLabel}"
                       VerticalAlignment="Center" />
                <controls:NumericSpinner Value="{Binding ViewModel.Action.SpeedFactorF, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         Grid.Column="1"
                                         Decimals="2"
                                         Step="0.05"
                                         Grid.ColumnSpan="2"
                                         MinValue="0"
                                         Foreground="{DynamicResource TextColorBrush}"
                                         MaxValue="5"
                                         Height="32"
                                         Margin="3"
                                         ValueChanged="NumericSpinner_ValueChanged">
                </controls:NumericSpinner>

                
                <CheckBox Style="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"
                          Grid.Row="1"
                          FontSize="12"
                          Grid.ColumnSpan="2"
                          HorizontalAlignment="Left"
                          Foreground="{DynamicResource TextColorBrush}"
                          Margin="5"
                          ToolTip="If checked, Start Dummies are set explicitly and HasStartDummy will be activated on all nodes."
                          Background="{StaticResource WalkActionAccentColorBrush}"
                          Content="Explicit Start Dummies"
                          IsChecked="{Binding ExplicitStartDummies, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                
            </Grid>

            <CheckBox Style="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"
                      Grid.Row="1"
                      FontSize="12"
                      Foreground="{DynamicResource TextColorBrush}"
                      Grid.ColumnSpan="2"
                      HorizontalAlignment="Left"
                      Margin="5"
                      Background="{StaticResource WalkActionAccentColorBrush}"
                      Content="Walk from Current Position"
                      ToolTip="Sets 'Walk from Current Position' for all Nodes"
                      IsChecked="{Binding ViewModel.Action.WalkFromCurrentPosition, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Style="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"
                      Grid.Row="1"
                      FontSize="12"
                      Grid.ColumnSpan="2"
                      Foreground="{DynamicResource TextColorBrush}"
                      HorizontalAlignment="Left"
                      Margin="5"
                      Background="{StaticResource WalkActionAccentColorBrush}"
                      ToolTip="Sets 'Use Target Dummy Direction' for all Nodes"
                      Content="Use Target Dummy Direction"
                      IsChecked="{Binding ViewModel.Action.UseTargetDummyDirection, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <Button x:Name="GenerateButton" 
                Grid.Row="2" 
                Margin="10,5"
                Click="GenerateButton_Click"
                BorderBrush="{DynamicResource WalkActionColorBrush}"
                Background="{DynamicResource WalkActionAccentColorBrush}"
                Style="{DynamicResource MaterialDesignRaisedLightButton}"
                Content="Generate Walk">            
        </Button>
    </Grid>
</Window>
